<!DOCTYPE html>
<html lang="en">

<!-- head -->
<%- include('../partials/head') %>

    <body>
        <div class="wrapper">
            <!-- Sidebar -->
            <%- include('../partials/sidebar') %>
                <div class="main-panel">
                    <div class="main-header">
                        <div class="main-header-logo">
                            <!-- Logo Header -->
                            <div class="logo-header" data-background-color="dark">
                                <div class="nav-toggle">
                                    <button class="btn btn-toggle toggle-sidebar">
                                        <i class="gg-menu-right"></i>
                                    </button>
                                    <button class="btn btn-toggle sidenav-toggler">
                                        <i class="gg-menu-left"></i>
                                    </button>
                                </div>
                                <button class="topbar-toggler more">
                                    <i class="gg-more-vertical-alt"></i>
                                </button>
                            </div>
                            <!-- End Logo Header -->
                        </div>
                        <!-- Navbar Header -->
                        <nav class="navbar navbar-header navbar-header-transparent navbar-expand-lg border-bottom">
                            <div class="container-fluid">
                                <nav
                                    class="navbar navbar-header-left navbar-expand-lg navbar-form nav-search p-0 d-none d-lg-flex">
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <button type="submit" class="btn btn-search pe-1">
                                                <i class="fa fa-search search-icon"></i>
                                            </button>
                                        </div>
                                        <input type="text" placeholder="Tìm kiếm..." class="form-control" />
                                    </div>
                                </nav>
                            </div>
                        </nav>
                        <!-- End Navbar -->
                    </div>

                    <div class="container">
                        <div class="page-inner">
                            <div class="page-header">
                                <!-- Name Table -->
                                <%- include('../partials/name-table') %>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="card">
                                        <div class="card-header">
                                            <div class="d-flex align-items-center">
                                                <h4>Danh sách đơn hàng</h4>
                                            </div>
                                        </div>
                                        <div class="card-body">
                                            <!-- Data Table -->
                                            <div class="table-responsive">
                                                <table id="add-row" class="display table table-striped table-hover">
                                                    <thead>
                                                        <tr>
                                                            <th>Họ và tên</th>
                                                            <th>Địa chỉ</th>
                                                            <th>Số điện thoại</th>
                                                            <th>Phương thức thanh toán</th>
                                                            <th>Thanh toán</th>
                                                            <th>Trạng thái</th>
                                                            <th>Tổng tiền</th>
                                                            <th style="width: 10%">Thao tác</th>
                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            <th>Họ và tên</th>
                                                            <th>Địa chỉ</th>
                                                            <th>Số điện thoại</th>
                                                            <th>Phương thức thanh toán</th>
                                                            <th>Thanh toán</th>
                                                            <th>Trạng thái</th>
                                                            <th>Tổng tiền</th>
                                                            <th>Thao tác</th>
                                                        </tr>
                                                    </tfoot>
                                                    <tbody>
                                                        <% orders.forEach(order=>{ %>
                                                            <tr>
                                                                <td>
                                                                    <%=order.shippingAddress.fullName %>
                                                                </td>
                                                                <td>
                                                                    <%=order.shippingAddress.address %>
                                                                </td>
                                                                <td>
                                                                    <%=order.shippingAddress.phone %>
                                                                </td>
                                                                <td>
                                                                    <%=order.paymentMethod === 'COD' ? 'Tiền mặt (COD)' : order.paymentMethod %>
                                                                </td>
                                                                <td>
                                                                    <span class="badge <%= order.paymentStatus === 'paid' ? 'bg-success' : 'bg-warning text-dark' %>">
                                                                        <%= order.paymentStatus === 'paid' ? 'Đã thanh toán' : 'Chưa thanh toán' %>
                                                                    </span>
                                                                </td>
                                                                <td id="chang-status">
                                                                    <% 
                                                                        let statusBadge = 'bg-secondary';
                                                                        let statusText = order.status;
                                                                        if (order.status === 'pending') { statusBadge = 'bg-warning text-dark'; statusText = 'Chờ duyệt'; }
                                                                        else if (order.status === 'waiting') { statusBadge = 'bg-info'; statusText = 'Đã duyệt'; }
                                                                        else if (order.status === 'shipping') { statusBadge = 'bg-primary'; statusText = 'Đang giao'; }
                                                                        else if (order.status === 'delivered') { statusBadge = 'bg-success'; statusText = 'Đã giao'; }
                                                                        else if (order.status === 'cancelled') { statusBadge = 'bg-danger'; statusText = 'Đã hủy'; }
                                                                    %>
                                                                    <span class="badge <%= statusBadge %>"><%= statusText %></span>
                                                                </td>
                                                                <td>
                                                                    <%=order.totalAmount ? order.totalAmount.toLocaleString('vi-VN') : 0 %> <u>đ</u>
                                                                </td>
                                                                <td>
                                                                    <div class="form-button-action">
                                                                        <div id="chang-status-icon">
                                                                            <% if(order.status=="pending" ){ %>
                                                                                <form action="/orders/approved"
                                                                                    method="post">
                                                                                    <input type="hidden" name="id"
                                                                                        value="<%=order.id %>">
                                                                                    <div class="form-button-action">
                                                                                        <div class="form-button-action">
                                                                                            <button type="submit"
                                                                                                data-bs-toggle="tooltip"
                                                                                                title="Duyệt đơn"
                                                                                                class="btn btn-link btn-warning">
                                                                                                <i
                                                                                                    class="fa fa-hourglass-half"></i>
                                                                                            </button>
                                                                                        </div>
                                                                                    </div>
                                                                                </form>
                                                                                <% } else if(order.status=="waiting" ){
                                                                                    %>
                                                                                    <div class="form-button-action">
                                                                                        <button type="button"
                                                                                            data-bs-toggle="tooltip"
                                                                                            title="Đã duyệt"
                                                                                            class="btn btn-link btn-success">
                                                                                            <i
                                                                                                class="fa fa-check"></i>
                                                                                        </button>
                                                                                    </div>
                                                                                    <% } else{ %>
                                                                                        <div class="form-button-action">
                                                                                            <button type="button"
                                                                                                data-bs-toggle="tooltip"
                                                                                                title="Hoàn tất"
                                                                                                class="btn btn-link btn-secondary">
                                                                                                <i
                                                                                                    class="fa fa-check-double"></i>
                                                                                            </button>
                                                                                        </div>
                                                                                        <% } %>
                                                                        </div>

                                                                        <form action="/orders/detail" method="post">
                                                                            <input type="hidden" name="id"
                                                                                value="<%=order.id %>">
                                                                            <div class="form-button-action">
                                                                                <div class="form-button-action">
                                                                                    <button type="submit"
                                                                                        data-bs-toggle="tooltip"
                                                                                        title="Chi tiết đơn hàng"
                                                                                        class="btn btn-link btn-info">
                                                                                        <i class="fa fa-eye"></i>
                                                                                    </button>
                                                                                </div>
                                                                            </div>
                                                                        </form>
                                                                        <form class="btn-destroy-order"
                                                                            action="/orders/cancelled" method="post">
                                                                            <input type="hidden" name="id"
                                                                                value="<%=order.id %>">
                                                                            <div class="form-button-action">
                                                                                <div class="form-button-action">
                                                                                    <button type="submit"
                                                                                        data-bs-toggle="tooltip"
                                                                                        title="Hủy đơn hàng"
                                                                                        class="btn btn-link btn-danger">
                                                                                        <i class="fa fa-times"></i>
                                                                                    </button>
                                                                                </div>
                                                                            </div>
                                                                        </form>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Footer -->
                    <%- include('../partials/footer') %>
                </div>
        </div>
        <!-- Table Script -->
        <%- include('../partials/table-script') %>
            <!-- My Script -->
            <%- include('../partials/my-script') %>
    </body>

</html>