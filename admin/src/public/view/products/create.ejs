<!DOCTYPE html>
<html lang="en">

<!-- head -->
<%- include('../partials/head') %>

    <body>
        <div class="wrapper">
            <!-- Sidebar -->
            <%- include('../partials/sidebar') %>
                <div class="main-panel">
                    <div class="main-header">
                        <div class="main-header-logo">
                            <!-- Logo Header -->
                            <div class="logo-header" data-background-color="dark">
                                <div class="nav-toggle">
                                    <button class="btn btn-toggle toggle-sidebar">
                                        <i class="gg-menu-right"></i>
                                    </button>
                                    <button class="btn btn-toggle sidenav-toggler">
                                        <i class="gg-menu-left"></i>
                                    </button>
                                </div>
                                <button class="topbar-toggler more">
                                    <i class="gg-more-vertical-alt"></i>
                                </button>
                            </div>
                            <!-- End Logo Header -->
                        </div>
                        <!-- Navbar Header -->
                        <nav class="navbar navbar-header navbar-header-transparent navbar-expand-lg border-bottom">
                            <div class="container-fluid">
                                <nav
                                    class="navbar navbar-header-left navbar-expand-lg navbar-form nav-search p-0 d-none d-lg-flex">
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <button type="submit" class="btn btn-search pe-1">
                                                <i class="fa fa-search search-icon"></i>
                                            </button>
                                        </div>
                                        <input type="text" placeholder="Tìm kiếm..." class="form-control" />
                                    </div>
                                </nav>
                            </div>
                        </nav>
                        <!-- End Navbar -->
                    </div>

                    <div class="container">
                        <div class="page-inner">
                            <div class="page-header">
                                <h3 class="fw-bold mb-3">Biểu mẫu</h3>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="card">
                                        <!-- Name Form -->
                                        <div class="card-header">
                                            <div class="d-flex align-items-center">
                                                <%- include('../partials/name-form') %>
                                                    <a href="/products" class="btn btn-danger btn-round ms-auto">
                                                        <i class="fa fa-arrow-left"></i>
                                                        Quay lại
                                                    </a>
                                            </div>
                                        </div>
                                        <form action="/products/store" method="post" enctype="multipart/form-data">
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="col-md-12 col-lg-12">
                                                        <div class="form-group">
                                                            <label for="name">Tên sản phẩm</label>
                                                            <input type="text" name="name" class="form-control"
                                                                id="name" placeholder="Nhập tên sản phẩm" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label for="description">Mô tả sản phẩm</label>
                                                            <input type="text" name="description" class="form-control"
                                                                id="description" placeholder="Nhập mô tả sản phẩm" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label for="type">Loại / Màu sắc</label>
                                                            <input type="text" name="type" class="form-control"
                                                                id="type" placeholder="Nhập loại (Ví dụ: Màu đen, Màu trắng...)" />
                                                        </div>
                                                        <style>
                                                            .seven-col {
                                                                width: calc(100% / 7);
                                                                float: left;
                                                                text-align: center;
                                                                padding: 0;
                                                            }
                                                        </style>
                                                        <div class="form-group">
                                                            <label for="price">Giá bán theo Size (VNĐ)</label>
                                                            <div class="container">
                                                                <div class="row">
                                                                    <div class="seven-col"><input type="number"
                                                                            step="any" name="price[XS]"
                                                                            class="form-control"
                                                                            placeholder="Giá XS" />
                                                                    </div>
                                                                    <div class="seven-col"><input type="number"
                                                                            step="any" name="price[S]"
                                                                            class="form-control"
                                                                            placeholder="Giá S" />
                                                                    </div>
                                                                    <div class="seven-col"><input type="number"
                                                                            step="any" name="price[M]"
                                                                            class="form-control"
                                                                            placeholder="Giá M" />
                                                                    </div>
                                                                    <div class="seven-col"><input type="number"
                                                                            step="any" name="price[L]"
                                                                            class="form-control"
                                                                            placeholder="Giá L" />
                                                                    </div>
                                                                    <div class="seven-col"><input type="number"
                                                                            step="any" name="price[XL]"
                                                                            class="form-control"
                                                                            placeholder="Giá XL" />
                                                                    </div>
                                                                    <div class="seven-col"><input type="number"
                                                                            step="any" name="price[XXL]"
                                                                            class="form-control"
                                                                            placeholder="Giá XXL" />
                                                                    </div>
                                                                    <div class="seven-col"><input type="number"
                                                                            step="any" name="price[XXXL]"
                                                                            class="form-control"
                                                                            placeholder="Giá XXXL" />
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label for="stock">Số lượng tồn kho theo Size</label>
                                                            <div class="container">
                                                                <div class="row">
                                                                    <div class="seven-col"><input type="number"
                                                                            name="stock[XS]" class="form-control"
                                                                            placeholder="Kho XS" />
                                                                    </div>
                                                                    <div class="seven-col"><input type="number"
                                                                            name="stock[S]" class="form-control"
                                                                            placeholder="Kho S" />
                                                                    </div>
                                                                    <div class="seven-col"><input type="number"
                                                                            name="stock[M]" class="form-control"
                                                                            placeholder="Kho M" />
                                                                    </div>
                                                                    <div class="seven-col"><input type="number"
                                                                            name="stock[L]" class="form-control"
                                                                            placeholder="Kho L" />
                                                                    </div>
                                                                    <div class="seven-col"><input type="number"
                                                                            name="stock[XL]" class="form-control"
                                                                            placeholder="Kho XL" />
                                                                    </div>
                                                                    <div class="seven-col"><input type="number"
                                                                            name="stock[XXL]" class="form-control"
                                                                            placeholder="Kho XXL" />
                                                                    </div>
                                                                    <div class="seven-col"><input type="number"
                                                                            name="stock[XXXL]" class="form-control"
                                                                            placeholder="Kho XXXL" />
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label for="image">Hình ảnh sản phẩm</label>
                                                            <input type="file" name="image" class="form-control-file"
                                                                id="image" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-action">
                                                <button class="btn btn-success">Lưu sản phẩm</button>
                                            </div>
                                        </form>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Footer -->
                    <%- include('../partials/footer') %>
                </div>
        </div>
        <!-- Table Script -->
        <%- include('../partials/table-script') %>
            <!-- My Script -->
            <%- include('../partials/my-script') %>
    </body>

</html>